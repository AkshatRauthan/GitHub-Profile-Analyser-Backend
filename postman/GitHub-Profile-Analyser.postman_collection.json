{
  "info": {
    "_postman_id": "gpa-collection-v1",
    "name": "GitHub Profile Analyser API",
    "description": "Complete API collection for GitHub Profile Analyser.\n\n## Setup\n1. Import the environment file\n2. Select **GitHub Profile Analyser - Local** environment\n3. Run **Auth → Register** or **Auth → Login** (tokens auto-saved)\n4. Run **Demo Flow → Full Screening Workflow** for end-to-end demo\n\n## Private GitHub data\nSet `GITHUB_TOKEN` in backend `.env` with `repo` scope. Set `githubUsername` to your GitHub login (token owner) to test private repos and contributions.\n\n## Docs\nSee `backend/docs/` — api-reference.md, repo-composition.md, private-github-data.md, changelog.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: warn if token missing on protected routes",
          "const publicPaths = ['/auth/register', '/auth/login', '/auth/refresh', '/health'];",
          "const url = pm.request.url.toString();",
          "const isPublic = publicPaths.some(p => url.includes(p));",
          "if (!isPublic && !pm.environment.get('accessToken')) {",
          "    console.warn('⚠️  No accessToken in environment. Run Auth → Login or Register first.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: log response time",
          "pm.test('Response time under 30s', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(30000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Server is healthy', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(['healthy', 'degraded']).to.include(json.status);",
                  "    pm.expect(json.checks.database).to.be.oneOf(['connected', 'disconnected']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints. Register/Login auto-save tokens to environment.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"username\": \"{{userUsername}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Registration successful', () => pm.expect(json.success).to.be.true);",
                  "    if (json.data?.tokens) {",
                  "        pm.environment.set('accessToken', json.data.tokens.accessToken);",
                  "        pm.environment.set('refreshToken', json.data.tokens.refreshToken);",
                  "        pm.environment.set('userId', json.data.user.id);",
                  "        console.log('✅ Tokens saved to environment');",
                  "    }",
                  "} else if (pm.response.code === 409) {",
                  "    console.log('ℹ️  User already exists — run Login instead');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Success flag true', () => pm.expect(json.success).to.be.true);",
                  "if (json.data?.tokens) {",
                  "    pm.environment.set('accessToken', json.data.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', json.data.tokens.refreshToken);",
                  "    pm.environment.set('userId', json.data.user.id);",
                  "    console.log('✅ Tokens saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const tokens = json.data?.tokens || json.data;",
                  "    if (tokens?.accessToken) {",
                  "        pm.environment.set('accessToken', tokens.accessToken);",
                  "        pm.environment.set('refreshToken', tokens.refreshToken);",
                  "        console.log('✅ Tokens refreshed and saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Auth Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns user data', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {

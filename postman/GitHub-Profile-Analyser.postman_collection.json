          "name": "Search by Language & Stars",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/search?languages=JavaScript,TypeScript&minStars={{searchMinStars}}&sortBy=totalStars&sortOrder=desc&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles", "search"],
              "query": [
                { "key": "languages", "value": "JavaScript,TypeScript" },
                { "key": "minStars", "value": "{{searchMinStars}}" },
                { "key": "sortBy", "value": "totalStars" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }

DATABASE_URL="mysql://DB_USERNAME:DB_PASSWORD@DB_HOST:DB_PORT/DB_DATABASE?sslaccept=strict&connect_timeout=60&pool_timeout=60"
# TiDB Cloud: ensure your IP is allowlisted and the cluster is not paused.

DB_HOST=host
DB_PORT=port
DB_USERNAME=username
DB_PASSWORD=password
DB_DATABASE=database

PORT=3000
CORS_ORIGINS=http://localhost:5173 # All possible origins separated by commas
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Seconds (numeric only — do not quote; jwt v9 treats "3600" as milliseconds)
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400
JWT_SECRET=your-secret-key
COOKIE_SECRET=your-cookie-secret

GITHUB_TOKEN=
# Optional PAT with `repo` scope — when set, private repos and contributions
# are included for profiles the token can access (typically the token owner).